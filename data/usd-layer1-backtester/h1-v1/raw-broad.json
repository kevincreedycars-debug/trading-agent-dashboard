{
  "input": "broad",
  "series": "H.10 weekly release pages, memo row 1) BROAD (Jan 2006 = 100)",
  "clock_rule": "h10_weekly_release",
  "clock_statement": "The Federal Reserve publishes H.10 on Monday at 16:15 ET, covering the previous business week.",
  "clock_policy": {
    "basis": "publisher_stated_release_time",
    "rule": "A historical record has no receipt. Its publication clock is reconstructed as the publisher's stated release time on the stated release day, converted to UTC in the publisher's own time zone. The observed clock is the instant the value is determined, which is never later than the reconstructed publication clock. Both clocks, the rule id and the margin in hours to the 05:00 London cutoff are written onto every record.",
    "receipt": "received_at_utc is null on every historical record. A reconstructed clock is not a receipt.",
    "late_print": "The reconstruction assumes the stated release time was met. It cannot exclude a late print, which is why the margin is published and late-print rejection stays an untested gate."
  },
  "availability_evidence": "Each weekly release page is served at its own dated URL and carries the release date plus five daily values; reading the page published in the week that followed an observation keeps the first published value.",
