        "parameters": {
          "jsCode": "function clean(value) { if (value === null || value === undefined) return null; const text = String(value).trim(); return text === '' ? null : text; }\nfunction currencyFor(event) { const direct = clean(event.currencyCode || event.currency); if (direct) return direct.toUpperCase(); const map = { US: 'USD', DE: 'EUR', FR: 'EUR', IT: 'EUR', ES: 'EUR', GB: 'GBP', JP: 'JPY', CN: 'CNY' }; return map[String(event.countryCode || '').toUpperCase()] || null; }\nfunction impactRank(value) { const text = String(value || '').toUpperCase(); return text === 'HIGH' ? 3 : text === 'MEDIUM' ? 2 : text === 'LOW' ? 1 : 0; }\nfunction relevance(currency) { if (currency === 'USD') return ['USD', 'EUR', 'Gold', 'NQ', 'BTC']; if (currency === 'EUR') return ['EUR', 'USD']; return []; }\nfunction eventDate(value) { const date = new Date(value); return Number.isFinite(date.getTime()) ? date.toISOString().slice(0, 10) : null; }\nconst rows = $input.all().flatMap((item) => Array.isArray(item.json?.data) ? item.json.data : Array.isArray(item.json) ? item.json : []);\nconst output = new Map();\nfor (const event of rows) {\n  const scheduledAt = clean(event.dateUtc || event.date_utc || event.date);\n  const event_date = eventDate(scheduledAt);\n  const currency = currencyFor(event);\n  const event_name = clean(event.name || event.event || event.title);\n  if (!scheduledAt || !event_date || !currency || !event_name) continue;\n  const impact = clean(event.volatility || event.impact);\n  const row = { event_date, event_time_text: scheduledAt, event_time_utc: scheduledAt, currency, impact, event_name, actual: clean(event.actual), forecast: clean(event.consensus ?? event.forecast), previous: clean(event.previous), revised: clean(event.revised), surprise_direction: clean(event.actual) === null ? 'pending' : 'available', currency_signal: 'PENDING', impact_rank: impactRank(impact), asset_relevance: relevance(currency), source: 'economic_calendar_rapidapi', raw_json: event };\n  const key = [row.event_date, row.currency, row.event_name, row.event_time_text].join('|').toLowerCase();\n  output.set(key, row);\n}\nif (!output.size) throw new Error('Economic Calendar API returned zero usable USD/EUR events for the rolling seven-day window.');\nreturn Array.from(output.values()).map((json) => ({ json }));"
        },
