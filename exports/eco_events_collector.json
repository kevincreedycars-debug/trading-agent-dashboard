      "parameters": {
        "jsCode": "function buildKey(row) { return [row.event_date || '', row.currency || '', row.event_name || '', row.event_time_text || ''].join('|').toLowerCase(); }\nconst existingRows = $('Supabase | Get Existing Economic Events').all().map(i => i.json).filter(row => row && row.id);\nconst incomingRows = $('Code | Normalise Forex Factory Events').all().map(i => i.json).filter(row => row.currency && row.event_name);\nconst existingMap = new Map(existingRows.map(row => [buildKey(row), row]));\nreturn incomingRows.map(row => { const key = row._event_key || buildKey(row); const existing = existingMap.get(key); return { json: { ...row, _event_key: key, _action: existing ? 'update' : 'create', _existing_id: existing?.id || null } }; });"
