{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "usd-session-review-issue-register-v1",
  "title": "USD session review issue register",
  "description": "The artefact each frontier reviewer returns. One register per reviewer, stored separately so neither review is edited by the other and disagreements survive synthesis instead of being smoothed away.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assignment_id", "reviewer", "created_at", "reviewed_artefacts", "issues", "card_verdicts", "could_not_evaluate"],
  "properties": {
    "schema_version": { "const": "usd-session-review-issue-register-v1" },
    "assignment_id": { "enum": ["USD-SESSION-A3", "USD-SESSION-A4"] },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "name"],
      "properties": {
        "slot": { "enum": ["frontier-reviewer-a", "frontier-reviewer-b"] },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "created_at": { "type": "string", "format": "date" },
    "reviewed_artefacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "read"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" },
          "read": { "type": "boolean" }
        }
      },
      "description": "A reviewer must not claim to have reviewed a file whose hash it cannot state."
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_id", "severity", "objection", "basis", "remedy", "falsifiable_test", "affects_cards"],
        "properties": {
          "issue_id": { "type": "string", "pattern": "^[A-Z]{1,2}-[0-9]{1,3}$" },
          "severity": { "enum": ["blocker", "major", "minor", "note"] },
          "objection": { "type": "string", "minLength": 60 },
          "basis": { "type": "string", "minLength": 40 },
          "remedy": { "type": "string", "minLength": 30 },
          "falsifiable_test": { "type": "string", "minLength": 40 },
          "affects_cards": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "card_verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["card_id", "verdict", "reason"],
        "properties": {
          "card_id": { "type": "string" },
          "verdict": { "enum": ["keep_as_direction", "keep_as_regime", "keep_as_gate", "keep_as_abstention_gate", "drop", "unresolved"] },
          "reason": { "type": "string", "minLength": 30 }
        }
      }
    },
    "could_not_evaluate": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 20 }
    }
  }
}
