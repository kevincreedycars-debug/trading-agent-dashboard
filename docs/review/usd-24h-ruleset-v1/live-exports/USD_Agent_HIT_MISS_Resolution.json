    {
      "parameters": {
        "jsCode": "const currentPrices  = $('Code | Aggregate Prices').first().json;\nconst expiredCalls   = $('HTTP Request | Fetch Expired Calls').all().map(i => i.json);\n\nif (!expiredCalls || expiredCalls.length === 0) return [];\n\nconst resolved = [];\n\nfor (const call of expiredCalls) {\n  if (call.direction === 'NO TRADE') continue;\n\n  const entryPrice   = parseFloat(call.entry_price);\n  const currentPrice = currentPrices[call.market];\n\n  if (!entryPrice || !currentPrice) continue;\n\n  let status;\n  if (call.direction === 'LONG')       status = currentPrice > entryPrice ? 'HIT' : 'MISS';\n  else if (call.direction === 'SHORT') status = currentPrice < entryPrice ? 'HIT' : 'MISS';\n  else continue;\n\n  resolved.push({ json: { id: call.id, status } });\n}\n\nreturn resolved;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        -48
      ],
      "id": "29608f92-26ba-42c7-b4bb-8cec1ae392e7",
      "name": "Code | Resolve HIT/MISS",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const gold   = parseFloat($('HTTP Request | Gold - Coinbase').first().json?.data?.amount);\nconst btc    = parseFloat($('HTTP Request | BTC - Coinbase').first().json?.data?.amount);\nconst eurUsd = parseFloat($('HTTP Request | EUR/USD - Coinbase').first().json?.data?.amount);\nconst gbpUsd = parseFloat($('HTTP Request | GBP/USD - Coinbase').first().json?.data?.amount);\nconst jpyRaw = parseFloat($('HTTP Request | USD/JPY - Coinbase').first().json?.data?.amount);\nconst cadRaw = parseFloat($('HTTP Request | USD/CAD - Coinbase').first().json?.data?.amount);\nconst audUsd = parseFloat($('HTTP Request | AUD/USD - Coinbase').first().json?.data?.amount);\n\nconst wtiRaw = $('HTTP Request | WTI Oil - Alpha Vantage').first().json?.data?.[0]?.value;\nconst wti    = wtiRaw ? parseFloat(wtiRaw) : null;\n\nconst nqRaw = $('HTTP Request | NQ - Alpha Vantage').first().json?.['Global Quote']?.['05. price'];\nconst nq    = nqRaw ? parseFloat(nqRaw) : null;\n\nreturn [{\n  json: {\n    'EUR/USD': eurUsd,\n    'GBP/USD': gbpUsd,\n    'USD/JPY': jpyRaw ? 1 / jpyRaw : null,\n    'USD/CAD': cadRaw ? 1 / cadRaw : null,\n    'AUD/USD': audUsd,\n    'BTC/USD': btc,\n    'XAU/USD': gold,\n    'WTI Oil': wti,\n    'NQ':      nq,\n  }\n}];"
      },
