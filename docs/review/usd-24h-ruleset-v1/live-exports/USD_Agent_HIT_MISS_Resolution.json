    {
      "parameters": {
        "jsCode": "const prices = $('Code | Aggregate Prices').first().json;\n\nconst nullMarkets = Object.entries(prices)\n  .filter(([market, price]) => price === null)\n  .map(([market]) => market);\n\nconst hasErrors = nullMarkets.length > 0;\n\nreturn [{\n  json: {\n    hasErrors,\n    nullMarkets,\n    message: hasErrors \n      ? `Resolution workflow completed with missing prices: ${nullMarkets.join(', ')}`\n      : 'Resolution workflow completed cleanly'\n  }\n}];"
