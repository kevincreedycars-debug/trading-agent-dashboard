    {
      "parameters": {
        "jsCode": "function clean(v) {\n  if (v === null || v === undefined) return null;\n  const s = String(v).trim();\n  return s === '' ? null : s;\n}\n\nfunction num(v) {\n  if (v === null || v === undefined || v === '') return null;\n  const s = String(v)\n    .replace('%', '')\n    .replace('K', '')\n    .replace('M', '')\n    .replace(',', '')\n    .trim();\n\n  const n = Number(s);\n  return Number.isFinite(n) ? n : null;\n}\n\nfunction classifySurprise(e) {\n  const actual = num(e.actual);\n  const forecast = num(e.forecast);\n  const usual = String(e.usual_effect || '').toLowerCase();\n\n  if (actual === null || forecast === null) return 'pending';\n\n  let goodIfHigher = true;\n\n  if (\n    usual.includes('less than') ||\n    usual.includes('lower') ||\n    usual.includes('actual less')\n  ) {\n    goodIfHigher = false;\n  }\n\n  if (actual === forecast) return 'inline';\n\n  const better = goodIfHigher ? actual > forecast : actual < forecast;\n\n  return better ? 'beat' : 'miss';\n}\n\nfunction currencySignal(currency, surprise) {\n  if (surprise === 'beat') return 'BULLISH';\n  if (surprise === 'miss') return 'BEARISH';\n  if (surprise === 'inline') return 'NEUTRAL';\n  return 'PENDING';\n}\n\nfunction impactRank(impact) {\n  const s = String(impact || '').toLowerCase();\n  if (s.includes('high')) return 3;\n  if (s.includes('medium')) return 2;\n  if (s.includes('low')) return 1;\n  return 0;\n}\n\nfunction relevance(currency, name) {\n  const assets = [];\n\n  if (currency === 'EUR') {\n    assets.push('EUR', 'USD');\n  }\n\n  return [...new Set(assets)];\n}\n\nconst inputItems = $input.all().map(i => i.json);\n\nconst events = inputItems\n  .filter(e => {\n    const currency = clean(e.currency);\n    const name = String(e.name || '').toLowerCase();\n\n    return (\n      currency === 'EUR' &&\n      (\n        name.includes('pmi') ||\n        name.includes('manufacturing pmi') ||\n        name.includes('services pmi') ||\n        name.includes('composite pmi')\n      )\n    );\n  })\n  .map(e => {\n    const surprise = classifySurprise(e);\n    const currency = clean(e.currency);\n    const name = clean(e.name);\n    const signal = currencySignal(currency, surprise);\n\n    return {\n      event_date: clean(e.date),\n      event_time_text: clean(e.time),\n      event_time_utc: null,\n\n      currency,\n      impact: clean(e.impact),\n      event_name: name,\n\n      actual: clean(e.actual),\n      forecast: clean(e.forecast),\n      previous: clean(e.previous),\n      revised: null,\n\n      surprise_direction: surprise,\n      currency_signal: signal,\n      impact_rank: impactRank(e.impact),\n      asset_relevance: relevance(currency, name),\n\n      source: 'forex_factory_rapidapi_pmi_lookback',\n      raw_json: e\n    };\n  });\n\nreturn events.map(e => ({ json: e }));"
      },
