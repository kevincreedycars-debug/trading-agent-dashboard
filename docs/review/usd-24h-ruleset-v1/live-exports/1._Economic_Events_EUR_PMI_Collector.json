        "jsCode": "const days = [];\n\nfor (let i = 0; i <= 21; i++) {\n  const d = new Date();\n  d.setDate(d.getDate() - i);\n\n  days.push({\n    json: {\n      year: d.getFullYear(),\n      month: d.getMonth() + 1,\n      day: d.getDate()\n    }\n  });\n}\n\nreturn days;"
