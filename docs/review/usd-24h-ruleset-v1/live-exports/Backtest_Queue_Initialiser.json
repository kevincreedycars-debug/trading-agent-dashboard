      "parameters": {
        "jsCode": "const N = 100;\nconst tradingDays = [];\nlet date = new Date();\ndate.setDate(date.getDate() - 1);\n\nfunction addTradingDays(baseDate, n) {\n  const d = new Date(baseDate);\n  let added = 0;\n  while (added < n) {\n    d.setDate(d.getDate() + 1);\n    const day = d.getDay();\n    if (day !== 0 && day !== 6) added++;\n  }\n  return d.toISOString().split('T')[0];\n}\n\nwhile (tradingDays.length < N) {\n  date.setDate(date.getDate() - 1);\n  const day = date.getDay();\n  if (day === 0 || day === 6) continue;\n\n  const runDate = date.toISOString().split('T')[0];\n  tradingDays.push({\n    run_date: runDate,\n    resolution_date_24h: addTradingDays(date, 1),\n    resolution_date_72h: addTradingDays(date, 3),\n    resolution_date_weekly: addTradingDays(date, 5),\n    status: 'pending'\n  });\n}\n\nreturn [{ json: { rows: tradingDays } }];\n"
      },
