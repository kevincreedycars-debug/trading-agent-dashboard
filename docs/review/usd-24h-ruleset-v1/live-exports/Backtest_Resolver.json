    {
      "parameters": {
        "jsCode": "const item = $('Loop Over Items | Split in Batches').first().json;\nconst resolutionDate = item.resolution_date;\n\n// Fetch exit prices from market_prices table\nconst pricesArray = $('HTTP Request | Fetch Resolution Prices from DB').all().map(i => i.json);\n\nconst priceMap = {};\npricesArray.forEach(row => {\n  if (!priceMap[row.market]) {\n    priceMap[row.market] = parseFloat(row.close_price);\n  }\n});\n\nconst resolved = item.calls.map(call => {\n  const exitPrice = priceMap[call.market] || null;\n  const entryPrice = call.entry_price;\n\n  let status = 'UNRESOLVED';\n  let pctChange = null;\n\n  if (entryPrice && exitPrice) {\n    pctChange = (exitPrice - entryPrice) / entryPrice;\n    const threshold = call.market === 'BTC/USD' ? 0.005 : 0.001;\n\n    if (call.direction === 'LONG') {\n      status = pctChange > threshold ? 'HIT' : pctChange < -threshold ? 'MISS' : 'SCRATCH';\n    } else if (call.direction === 'SHORT') {\n      status = pctChange < -threshold ? 'HIT' : pctChange > threshold ? 'MISS' : 'SCRATCH';\n    }\n  }\n\n  return {\n    id: call.id,\n    exit_price: exitPrice,\n    status,\n    pct_change: pctChange ? parseFloat((pctChange * 100).toFixed(4)) : null\n  };\n});\n\nreturn resolved.map(r => ({ json: r }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
