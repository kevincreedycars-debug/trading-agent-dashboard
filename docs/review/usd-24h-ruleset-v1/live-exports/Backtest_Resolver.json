    {
      "parameters": {
        "jsCode": "const calls = $input.all().map(item => item.json);\n\n// Group calls by resolution date\nconst dateGroups = {};\ncalls.forEach(call => {\n  const date = call.resolution_date;\n  if (!dateGroups[date]) dateGroups[date] = [];\n  dateGroups[date].push(call);\n});\n\n// Return one item per unique resolution date\nreturn Object.keys(dateGroups).map(date => ({\n  json: {\n    resolution_date: date,\n    calls: dateGroups[date]\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
