      "id": "51edf037-6576-4f81-93ca-ed84b405600c",
      "name": "HTTP Request | Fetch Prices Batch 2 - Twelve Data"
    },
    {
      "parameters": {
        "jsCode": "const batch1 = $('HTTP Request | Fetch Prices Batch 1 - Twelve Data').first().json;\nconst batch2 = $('HTTP Request | Fetch Prices Batch 2 - Twelve Data').first().json;\n\nconst symbolMap = {\n  'EUR/USD': 'EUR/USD',\n  'GBP/USD': 'GBP/USD',\n  'USD/JPY': 'USD/JPY',\n  'USD/CAD': 'USD/CAD',\n  'AUD/USD': 'AUD/USD',\n  'XAU/USD': 'XAU/USD',\n  'WTI/USD': 'WTI Oil',\n  'BTC/USD': 'BTC/USD',\n  'QQQ':     'NQ'\n};\n\nconst rows = [];\n\nconst allData = { ...batch1, ...batch2 };\n\nObject.entries(allData).forEach(([symbol, data]) => {\n  if (!data.values) return;\n  const market = symbolMap[symbol];\n  if (!market) return;\n\n  data.values.forEach(bar => {\n    rows.push({\n      price_date:  bar.datetime,\n      market:      market,\n      open_price:  parseFloat(bar.open),\n      close_price: parseFloat(bar.close),\n      source:      'TwelveData'\n    });\n  });\n});\n\nreturn rows.map(r => ({ json: r }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
