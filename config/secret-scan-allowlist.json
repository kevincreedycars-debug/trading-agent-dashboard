{
  "version": "1.0.0",
  "rules": [
    {
      "path_regex": "^script\\.js$",
      "line_regex": "researchSupabaseKey",
      "reason": "Intentional browser-facing Supabase publishable key. Review separately from private credential scanning."
    },
    {
      "path_regex": "^backtester/tests/secret_scanner\\.test\\.js$",
      "line_regex": "BEGIN PRIVATE KEY|gh[p]_FAKEPLACEHOLDERTOKENVALUE|PLACEHOLDERSECRET123456|PLACEHOLDERBEARERTOKEN1234567890|PLACEHOLDERENVVALUE123456|UNTRACKEDPLACEHOLDER123456|STAGEDPLACEHOLDER123456|QUIETPLACEHOLDER123456|gh[p]_SHOULDNOTAPPEARINOUTPUT1234567890",
      "reason": "Synthetic placeholder fixtures for repository secret-scanner tests."
    },
    {
      "path_regex": "^backtester/tests/secret_scanner\\.test\\.js$",
      "line_regex": "RAPIDAPIHEADERPLACEHOLDER123456",
      "reason": "Synthetic scanner regression input."
    },
    {
      "path_regex": "^backtester/importers/fred/README\\.md$",
      "line_regex": "^\\$env:(FRED_API_KEY|SUPABASE_SERVICE_ROLE_KEY)\\s*=\\s*\"your_[a-z_]+\"$",
      "reason": "Documented placeholder, not a credential."
    },
    {
      "path_regex": "^(CODEX\\.md|docs/archive/pre-consolidation-20260907/CODEX\\.md|mcp-n8n/README\\.md)$",
      "line_regex": "^N8N_API_KEY=<secret>$",
      "reason": "Documented placeholder."
    },
    {
      "path_regex": "^mcp-n8n/src/server\\.ts$",
      "line_regex": "^const N8N_API_KEY = process\\.env\\.N8N_API_KEY;$",
      "reason": "Runtime environment lookup."
    },
    {
      "path_regex": "^backtester/(scripts/run_with_linked_supabase_env\\.js|tests/(evaluation_pipeline|replay_smoke)\\.test\\.js)$",
      "line_regex": "^  const service[R]ole = apiKeys\\.find\\(\\(key\\) => key\\.name === \"service[_]role\"\\)\\?\\.api_key;$",
      "reason": "Credential lookup expression, not a literal."
    },
    {
      "path_regex": "^Design Reference/claude dash example\\.txt$",
      "line_regex": "^  const token=document\\.getElementById\\('setup-token'\\)\\.value\\.trim\\(\\);$",
      "reason": "DOM input lookup in historical design reference."
    },
    {
      "path_regex": "^exports/gbp_collector\\.json$",
      "line_regex": "FRED_API_KEY_PLACEHOLDER_DO_NOT_COMMIT_REAL_KEY",
      "reason": "Inactive GBP draft uses an explicit placeholder."
    }
  ]
}
