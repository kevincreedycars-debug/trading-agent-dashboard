{
  "version": "gold-factor-direction-expectations-v1",
  "created": "2026-09-27",
  "status": "declared_expectations_not_results",
  "research_only": true,
  "objective": "Declare, for each measured Gold variable state, the direction the Layer 1 logic document says Gold should move, so the accepted single-variable report can be scored as a hit rate rather than as a marginal association. The file contains no outcome values and no measurements.",
  "written_after_report_acceptance": true,
  "written_after_report_note": "This mapping was written after the accepted report existed. It maps the logic document onto the report's state vocabulary; it does not select states, rank states or read the direction counts. Any scorer must report it as a declared reading of an existing document, not as a pre-registration.",
  "direction_convention": {
    "BULLISH": "The realized return between entry and endpoint is expected to be positive (Gold up).",
    "BEARISH": "The realized return between entry and endpoint is expected to be negative (Gold down).",
    "NEUTRAL": "The logic document declares no directional expectation for this state. The state is printed but not scored.",
    "outcome_source": "Accepted report cell direction counts: positive, negative, exact_zero. Exact zero is not an economic flat band and is excluded from the hit-rate denominator.",
    "hit_rate": "Expected-side count divided by (positive + negative).",
    "benchmark": "A directional call carries no information if it scores exactly the unconditioned rate of the side it called. The drift-adjusted edge is the hit rate minus that side's own baseline rate for the same cohort and horizon."
  },
  "sources": [
    {
      "path": "logic/agent_gold_direction.md",
      "declared_version": "2.0",
      "role": "The document whose factor rules are turned into directional expectations. Rules are quoted verbatim in rule_text."
    },
    {
      "path": "backtester/registries/gold_individual_variable_report.v2.json",
      "role": "Declares the measured state vocabulary the expectations must be expressed in. Revision 8 retires the four dxy ids and adds four level variables. Its variable_state_strata block states that no threshold, band or tercile is introduced, and that per-family direction conventions for surprise signs are not established."
    }
  ],
  "provenance_values": {
    "declared": "The logic document states the direction for a state with the same meaning as the report's state.",
    "interpreted": "The logic document's rule covers the same idea but not the report's exact state label, so the mapping is a reading. Reported separately and never counted as declared.",
    "not_declared": "The logic document makes no directional statement that covers this state. The state is printed unscored."
  },
  "caveat_values": {
    "threshold_not_applied": "The document's rule carries a magnitude threshold (5bps or 0.30%). The report declares that no threshold is applied, so its state is the sign of the change only and a change inside the threshold is scored as if it were outside it.",
    "proxy_series": "The document names DXY. The accepted report retires the dxy ids and measures the FRED broad dollar index instead, which is a proxy and not the same series.",
    "threshold_is_absolute_band": "The document's rule uses absolute bands (VIX above 25, below 16). The report splits each level at the variable's own median, which is not that band and cannot be recovered from the report.",
    "level_band_not_declared": "The document's rule for this factor is a change rule. It makes no statement about where the level sits relative to its own history, so the report's own-median split has no declared direction.",
    "regime_label_not_reproduced": "The document's rule is written in categorical regime names (expansion, contraction, stress, calm). The report measures the level's own median split and does not reproduce the agent's categorical regime names.",
    "prior_context_state": "The report's state is the sign of a prior-session, prior-five-session or prior-twenty-session Gold return, which is the document's gold-price-delta input taken as preceding context rather than as the current delta.",
    "family_scoped_sign": "The report's surprise-sign strata are family-scoped (<family>|<sign>) because raw signs are not comparable across families, and the coverage registry declares that per-family direction conventions are not established. The pooled across-family row is labelled non_comparable.",
    "event_cohort_only": "The variable is measured in the event-release cohort and not on the weekday anchor grid, so it is unscored in a daily-cohort table.",
    "interpreted_sign_mapping": "The document's inflation states are named as conditions (hot inflation with dovish expectations, disinflation). The report measures the sign of the change of the inflation signal and the coverage registry maps positive to rising, exact_zero to unchanged and negative to falling. The mapping from that sign to the document's condition is a reading, so the row is scored as interpreted and never counted as declared.",
    "interpreted_regime_mapping": "The document's safe-haven states are named as conditions (geopolitical stress, financial stress, calm). The report measures attention to risk headlines relative to its own median, so the high half is read as the stress condition and the low half as calm. This is a reading, so the row is scored as interpreted.",
    "change_rule_absent": "The document states no directional rule at all for a change in this variable, so there is no expectation to score.",
    "event_field_has_no_direction_rule": "The document names event fields as inputs without declaring a direction for the field's own state, so the state carries no expectation."
  },
